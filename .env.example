# OrderUp Environment Configuration
# ===============================
# Copy this file to .env and fill in your actual values
# Example usage:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual values

# Application Configuration
NODE_ENV=development
PORT=3000

# New Relic APM Configuration
# ---------------------------
# These are used by the APM agent to connect to New Relic
NEW_RELIC_APP_NAME="OrderUp"
NEW_RELIC_ACCOUNT_ID=
# Dashboard deep links use the same server-side User API key below; never send it to the browser.
# Defaults to the OrderUp Overview dashboard in account 1352811. Change both for another account.
NEW_RELIC_DASHBOARD_GUID=MTM1MjgxMXxWSVp8REFTSEJPQVJEfGRhOjEzNDMxMzI3
NEW_RELIC_REGION=us
# Browser app entity GUID (entityGuid on any PageAction event); used for "Open the browser app" links
NEW_RELIC_BROWSER_ENTITY_GUID=
# Numeric browser appId (appId on any PageAction event); used to upload source maps
NEW_RELIC_BROWSER_APP_ID=
NEW_RELIC_LICENSE_KEY=your_newrelic_license_key_here
# GUID of the APM entity, for deployment markers (npm run deploy:marker). Find it in New Relic: your app > Settings.
ENTITY_GUID=

# New Relic API Configuration (deployment markers and dashboard deep links)
# ---------------------------------------------------
# These secrets are used to create deployment markers in New Relic
# They are not required for the APM agent to function, but are useful for tracking deployments
# You can create these in New Relic One under your user profile -> API Keys
NEW_RELIC_API_KEY=your_new_relic_api_key_here

# New Relic Infrastructure Integration
# -----------------------------------
# This same license key is used for infrastructure monitoring
# It enables monitoring of nginx, PostgreSQL, and host system metrics
# The license key is automatically passed to the infrastructure agent containers

# To create a New Relic API Key:
# 1. Go to New Relic One
# 2. Click on your user profile
# 3. Go to API Keys
# 4. Create a new User API key (not License key)
# The Entity GUID can be found in the application metadata in New Relic One

# Database Configuration
# ----------------------
# For Docker Compose setup, use 'db' as hostname when running in containers
DB_HOST=localhost
DB_PORT=5432
DB_NAME=orderup
DB_USER=orderup_user
DB_PASSWORD=your_database_password_here
DB_SSL=false

# Docker Compose Database Configuration (alternative)
# When running with docker-compose, use these settings:
# DB_HOST=db
# DB_PASSWORD is read from here; db/password.txt is only an optional fallback the server reads when DB_PASSWORD is unset

# Demo exercise (optional)
# ------------------------
# Slug of a restaurant whose menu should fail with a 500, so students can find the error in New Relic.
# Leave empty to turn it off. Example: DEMO_FAILING_RESTAURANT=when_in_rome
DEMO_FAILING_RESTAURANT=

# Slug of a restaurant whose orders should always fail with a 500, and/or of a menu item that makes any order
# containing it fail. Leave empty to turn them off. Example: DEMO_FAILING_ORDER_ITEM=chicken_tikka
DEMO_FAILING_ORDER_RESTAURANT=
DEMO_FAILING_ORDER_ITEM=
# Set to off to stop the weekly automatic rotation of planned failures (one is armed almost all the time otherwise).
DEMO_FAILURE_ROTATION=

# Investigations (see the /instructor page, which can arm these at runtime without editing this file).
# Seconds (1-10) to slow every order's database work:
DEMO_DB_SLOW_ORDER_QUERY=
# Truthy values (anything but empty, 0 or off) arm: proxy 502s, a table lock, a 200k-customer history, a poison order.
DEMO_NGINX_502=
DEMO_DB_LOCK=
DEMO_DB_BIG_ORDERS=
DEMO_ORDER_POISON=

# Database wait events for New Relic: a short episode of row-lock waits on a scratch table, on a schedule.
# Truthy arms it (or use the /instructor page). Timing is optional; defaults shown.
DEMO_DB_WAIT_EVENTS=
# DEMO_DB_WAIT_EVENTS_INTERVAL_SECONDS=180
# DEMO_DB_WAIT_EVENTS_EPISODE_SECONDS=20

# Order status worker timing (optional; defaults shown)
# ORDER_STATUS_POLL_MS=20000
# ORDER_STATUS_PENDING_SECONDS=45
# ORDER_STATUS_PREPARING_SECONDS=75
# ORDER_STATUS_OUT_SECONDS=75

